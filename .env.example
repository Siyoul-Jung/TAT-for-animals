# ─── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe ─────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Customer Portal 구성 ID (선택). 없으면 계정 기본 구성으로 graceful fallback.
# MANAGE = 취소/결제수단 전용(플랜변경 없음, /api/portal), 일반 = 범용.
STRIPE_PORTAL_CONFIG_ID=
STRIPE_PORTAL_MANAGE_CONFIG_ID=

# Stripe Price IDs — Stripe 대시보드에서 상품 생성 후 입력 (가격 확정 후)
STRIPE_PRICE_CALM_LIBRARY=price_
STRIPE_PRICE_CALM_CIRCLE=price_
# 연간(yearly) 가격 — 월 가격 ×10 (2개월 무료). 같은 상품에 연 1회 가격 추가.
STRIPE_PRICE_CALM_LIBRARY_ANNUAL=price_
STRIPE_PRICE_CALM_CIRCLE_ANNUAL=price_
# 기존 tatlife 구독자 재구독용 grandfathered 요금 — Calm Circle 상품 아래 별도 가격 ($10/mo)
STRIPE_PRICE_FOUNDING_MEMBER=price_
# 재구독 안내 페이지 공유 비밀번호 (Jez 요청, 명단에게만 링크+비번 전달)
RESUBSCRIBE_PAGE_PASSWORD=
# 사이트 공개 발표일(ISO 날짜, 예: 2026-10-01) — 미설정 시 /welcome-back 계속 오픈.
# 값 설정 시 그로부터 30일 뒤 페이지가 자동으로 닫힘(Jez/Tapas 확정, 2026-09-01).
WELCOME_BACK_ANNOUNCED_AT=

# ─── PayPal ─────────────────────────────────────────────────
# 'sandbox' = 테스트, 비워두거나 그 외 값 = 라이브(api-m.paypal.com).
PAYPAL_ENV=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Plan IDs — 월간 + 연간 (연간은 같은 product에 YEAR 주기 플랜으로 생성)
PAYPAL_PLAN_CALM_LIBRARY=
PAYPAL_PLAN_CALM_CIRCLE=
PAYPAL_PLAN_CALM_LIBRARY_ANNUAL=
PAYPAL_PLAN_CALM_CIRCLE_ANNUAL=
# 기존 tatlife 구독자 재구독용 grandfathered 요금 ($10/mo) — Stripe 쪽과 동일 개념
PAYPAL_PLAN_FOUNDING_MEMBER=

# ─── Sanity CMS ─────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# ─── Resend (email) ─────────────────────────────────────────
RESEND_API_KEY=
# Where operational failure alerts (webhook / payment / deletion errors) are
# emailed. Defaults to the site owner if unset. Set to a team/ops inbox.
OPS_ALERT_EMAIL=
# Where the biweekly member-list CSV (name/email/tier/status, for Jan's
# revenue reconciliation) is emailed. Comma-separated for multiple inboxes.
# No fallback — the cron skips sending if this is unset, since the file
# contains every member's email.
MEMBER_EXPORT_EMAIL=

# ─── Sanity Webhook ──────────────────────────────────────────
SANITY_WEBHOOK_SECRET=

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret for Vercel Cron auth (annual renewal reminder). Vercel sends it as
# `Authorization: Bearer <CRON_SECRET>`; set the same value in Vercel env.
CRON_SECRET=
